# ============================================================
# SaloneMarket — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Supabase Project ---
# Found at: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# --- Supabase Service Role Key ---
# CRITICAL: This key bypasses RLS. Use only in Edge Functions via Supabase Secrets.
# NEVER put this in the Flutter app or commit it to git.
# Set via: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<value>
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Flutter Build (passed via --dart-define) ---
# Used in flutter run / flutter build commands:
# flutter run --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
FLUTTER_SUPABASE_URL=https://your-project-ref.supabase.co
FLUTTER_SUPABASE_ANON_KEY=your-anon-public-key-here

# --- Supabase CLI Authentication ---
# Required for running supabase db push / supabase functions deploy
# Found at: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=your-supabase-access-token-here

# --- GitHub Actions Secrets ---
# Configure these in: GitHub repo > Settings > Secrets and variables > Actions
# SUPABASE_ACCESS_TOKEN   — same as above, for CI migration deployment
# SUPABASE_DB_PASSWORD    — your Supabase database password

# --- Local Development Only ---
# Used by supabase CLI for local dev (supabase start)
# SUPABASE_DB_PASSWORD=postgres  # local default
