# ============================================================
# SaloneMarket — Root .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
supabase.dev.json
supabase.*.json
*.dev.json
*.local.json
*.pem
*.key
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

# --- Supabase ---
.branches/
supabase/.temp/

# --- Node ---
node_modules/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.idea/
*.iml
.vscode/

# --- Flutter/Dart (root level) ---
.dart_tool/
app/.localappdata/
scratch/

# --- Coverage ---
coverage/

# --- Build artifacts ---
*.apk
*.ipa
*.aab

# --- Certificates ---
*.p12
*.mobileprovision

# NOTE: app/pubspec.lock is intentionally NOT ignored (reproducible builds)
